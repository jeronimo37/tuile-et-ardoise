---
const { project } = Astro.props;
const cover = project.data.cover;
---
<article class="project-card">
  <img src={cover} alt={`Réalisation : ${project.data.title}`} loading="lazy" />
  <div><p class="eyebrow">{project.data.category} · {project.data.location}</p><h3>{project.data.title}</h3></div>
</article>
